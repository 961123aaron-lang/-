{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "council-of-high-intelligence": {
      "source": {
        "source": "github",
        "repo": "0xNyk/council-of-high-intelligence"
      }
    },
    "claude-for-financial-services": {
      "source": {
        "source": "github",
        "repo": "anthropics/financial-services-plugins"
      }
    }
  },
  "enabledPlugins": {
    "council@council-of-high-intelligence": true,
    "financial-analysis@claude-for-financial-services": true,
    "equity-research@claude-for-financial-services": true,
    "market-researcher@claude-for-financial-services": true,
    "earnings-reviewer@claude-for-financial-services": true
  }
}
